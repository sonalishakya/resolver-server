{
  "templates": [
    {
      "template_name": "Search By City",
      "template_id": "search-by-city",
      "base_template": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "type": "object",
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "ttl": {
                "type": "string",
                "const": "PT30S"
              },
              "city": {
                "type": "string",
                "enum": "{{city_code}}"
              },
              "action": {
                "type": "string",
                "const": "search"
              },
              "bap_id": {
                "type": "string",
                "const" : "{{bap_id}}"
              },
              "domain": {
                "type": "string",
                "enum": "{{domain}}"
              },
              "bap_uri": {
                "type": "string",
                "const": "{{bap_id}}"
              },
              "country": {
                "type": "string",
                "const": "{{country}}"
              },
              "timestamp": {
                "type": "string",
                "const": "{{timestamp}}"
              },
              "message_id": {
                "type": "string",
                "const": "{{message_id}}"
              },
              "core_version": {
                "type": "string",
                "const": "1.2.0"
              },
              "transaction_id": {
                "type": "string",
                "const": "{{transaction_id}}"
              },
              "bpp_id": {
                "type": "string",
                "const": "{{bap_id}}"
              },
              "bpp_uri": {
                "type": "string",
                "const": "{{bpp_uri}}"
              }
            },
            "required": [
              "ttl",
              "city",
              "action",
              "bap_id",
              "domain",
              "bap_uri",
              "country",
              "timestamp",
              "message_id",
              "core_version",
              "transaction_id",
              "bpp_id",
              "bpp_uri"
            ]
          },
          "message": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "object",
                "properties": {
                  "payment": {
                    "type": "object",
                    "properties": {
                      "@ondc/org/buyer_app_finder_fee_type": {
                        "type": "string"
                      },
                      "@ondc/org/buyer_app_finder_fee_amount": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "@ondc/org/buyer_app_finder_fee_type",
                      "@ondc/org/buyer_app_finder_fee_amount"
                    ]
                  }
                },
                "required": [
                  "payment"
                ]
              }
            },
            "required": [
              "intent"
            ]
          }
        },
        "required": [
          "context",
          "message"
        ]
      },
      "creation_prop": {
        "optional": [],
        "mandatory": ["domain", "city_code", "country_code"]
      },
      "runtime_prop": {
        "optional": [],
        "mandatory": [
          "transaction_id",
          "message_id",
          "timestamp",
          "bap_id",
          "bap_uri"
        ]
      },
      "additional_prop": [
        {
          "key": "buyer_finder_fee_percent",
          "value": "5"
        }
      ],
      "definition": {
        "attribute": {
          "city_code": {
            "type": "string",
            "values_url": "assets/data/city_code.json"
          },
          "domain": {
            "type": "string",
            "values_url": "assets/data/domain_code.json"
          },
          "country_code": {
            "type": "string",
            "values_url": "assets/data/country_code.json"
          }
        }
      }
    }
  ]
}
